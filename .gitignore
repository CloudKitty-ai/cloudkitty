# Rust
/target/
**/*.rs.bk
*.pdb

# CloudKitty runtime state
snapshot*.json
snapshot.json.tmp
snapshot.json.*.bak

# Editors / OS
.idea/
.vscode/
.DS_Store
Thumbs.db
*.swp
*.tmp

# Logs & env
*.log
.env
.env.*

# Python (training-surface dev: venv + bytecode)
.venv/
# quickstart-smoke.sh builds its own venv beside the crate so a bare
# runner works without clobbering a dev's .venv; ignored so a smoke
# run cannot stamp the binding's ENGINE_COMMIT -dirty (#452's probe
# scopes to crates/).
.venv-smoke/
__pycache__/

# Saved worlds (runtime state, like snapshot.json)
worlds.backup/

# Experiments (research artifacts): build outputs and raw data stay local
experiments/**/target/
experiments/**/raw/
experiments/**/artifacts/

# handoffs from designer
design-handoffs/
experiments/**/results-raw/
